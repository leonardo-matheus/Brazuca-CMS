# ==============================================
# BrazucaCMS Backend - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values

# GitHub Integration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/dashboard/integrations/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Shopify Integration
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

# Klaviyo Integration
KLAVIYO_API_KEY=your_klaviyo_api_key

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_INTEGRATION_WEBHOOK_SECRET=whsec_your_secret

# Auth0 Integration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://your-api.com

# Instagram/Meta Integration
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/dashboard/settings/social/callback
